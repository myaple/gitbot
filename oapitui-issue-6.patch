+#[derive(Default, Clone, Copy, PartialEq)]
+pub enum SortMode {
+    #[default]
+    None,
+    ByMethod,
+    ByPath,
+}
+
+impl SortMode {
+    pub fn next(self) -> Self {
+        match self {
+            Self::None => Self::ByMethod,
+            Self::ByMethod => Self::ByPath,
+            Self::ByPath => Self::None,
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::None => "none",
+            Self::ByMethod => "method",
+            Self::ByPath => "path",
+        }
+    }
+}
 
